# Local Properties Template
# Copy this file to local.properties and fill in the values
# DO NOT COMMIT local.properties to version control!

## Android SDK Location (auto-detected by Android Studio)
# sdk.dir=/path/to/android/sdk

## Release Signing Configuration
# Generate keystore with:
# keytool -genkey -v -keystore keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias reabuzz

# RELEASE_STORE_FILE=../keystore.jks
# RELEASE_STORE_PASSWORD=your_store_password
# RELEASE_KEY_ALIAS=reabuzz
# RELEASE_KEY_PASSWORD=your_key_password

## Optional: Custom SDK/NDK paths
# ndk.dir=/path/to/ndk
# cmake.dir=/path/to/cmake

## Google Play Publishing (for CI/CD)
# PLAY_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
